{
  "name": "naskali",
  "productName": "Naskali",
  "version": "0.1.0",
  "description": "Naskali – a SQL GUI proof of concept (Electron + Monaco + MySQL)",
  "homepage": "https://example.com/naskali",
  "desktopName": "naskali.desktop",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "dompurify": "^3.4.18"
  }
}
